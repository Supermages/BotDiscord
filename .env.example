# ==========================================
# Configuración del Bot de Discord (EriduBot)
# ==========================================

# Token del Bot de Discord (Obtenido en https://discord.com/developers/applications)
DISCORD_TOKEN=tu_token_de_discord_aqui

# (Opcional) ID de Webhook de Tupperbox predeterminado.
# El bot también lo detecta automáticamente por servidor.
TUPPER_WEBHOOK_ID=

# Nombre del rol de Discord requerido para ejecutar comandos administrativos
ROL_ADMIN="Bot Admin"

# Carpeta donde se guardan los archivos JSON de chat e imágenes temporales
EXPORT_FOLDER="data/exportaciones"

# Límite máximo total de mensajes permitidos por solicitud
MAX_MENSAJES_TOTAL=50

# Cantidad de mensajes por cada imagen generada (segmentación)
MENSAJES_POR_IMAGEN=10

# Límite de mensajes a escanear en el historial de Discord para encontrar los deseados
SEARCH_LIMIT=500
